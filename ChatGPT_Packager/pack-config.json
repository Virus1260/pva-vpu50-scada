  "excludeFilePatterns": [
    "*.pyc",
    "*.pyo",
    "*.pyd",
    "*.obj",
    "*.o",
    "*.exe",
    "*.dll",
    "*.so",
    "*.dylib",
    "*.lib",
    "*.a",
    "*.log",
    "*.tmp",
    "*.bak",
    "*.orig",
    "*.swp",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    ".DS_Store",
    "Thumbs.db",
    "desktop.ini",
    ".env*",
    "*secret*",
    "*credential*",
    "*token*",
    "*.pem",
    "*.key",
    "*.pfx",
    "*.user",
    "*.user.*",
    "*.autosave"
  ],
  "binaryExtensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".bmp",
    ".webp",
    ".ttf",
    ".woff",
    ".woff2",
    ".eot",
