import QmlProject

Project {
    mainFile: "PVA_VPU50_SCADAContent/App.qml"
    mainUiFile: "PVA_VPU50_SCADAContent/Main_frame_screenView.ui.qml"

    /* Include .qml, .js, and image files from current directory and subdirectories */
    QmlFiles {
        directory: "PVA_VPU50_SCADA"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/screens"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/widgets"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/widgets/Screen_1_Control"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/widgets/Screen_2_PID"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/widgets/Screen_5_Recipes"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/widgets/ScadaHeader"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/modals"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/components/modals/Screen_1_Control"
    }

    QmlFiles {
        directory: "PVA_VPU50_SCADAContent/config"
    }

    QmlFiles {
        directory: "Generated"
    }

    JavaScriptFiles {
        directory: "PVA_VPU50_SCADA"
    }

    JavaScriptFiles {
        directory: "PVA_VPU50_SCADAContent"
    }

    ImageFiles {
        directory: "PVA_VPU50_SCADAContent"
    }

    ImageFiles {
        directory: "Generated"
    }

    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        directory: "."
    }

    FontFiles {
        filter: "*.ttf;*.otf"
    }

    Files {
        filter: "*.wav;*.mp3"
    }

    Files {
        filter: "*.glsl;*.glslv;*.glslf;*.vsh;*.fsh;*.vert;*.frag"
    }

    Files {
        filter: "*.qsb"
    }

    Files {
        filter: "*.json"
        directory: "scada"
    }

    Files {
        filter: "*.mesh"
        directory: "Generated"
    }

    Files {
        filter: "*.qad"
        directory: "Generated"
    }

    /* Baked lightmaps */
    Files {
        filter: "*.bin;*.exr;*.mesh"
        directory: "PVA_VPU50_SCADAContent"
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true

    /* List of plugin directories passed to QML runtime */
    importPaths: [
        ".",
        "PVA_VPU50_SCADAContent",
        "PVA_VPU50_SCADAContent/components/widgets",
        "PVA_VPU50_SCADAContent/components/widgets/ScadaHeader",
        "PVA_VPU50_SCADAContent/components/widgets/Screen_1_Control",
        "PVA_VPU50_SCADAContent/components/widgets/Screen_5_Recipes",
        "PVA_VPU50_SCADAContent/components/modals",
        "PVA_VPU50_SCADAContent/components/modals/Screen_1_Control",
        "PVA_VPU50_SCADAContent/screens"
    ]

    /* Required for deployment */
    targetDirectory: "/opt/PVA_VPU50_SCADA"

    enableCMakeGeneration: true
    standaloneApp: true

    qdsVersion: "4.8"
    quickVersion: "6.8"

    widgetApp: true

    multilanguageSupport: true
    supportedLanguages: ["en"]
    primaryLanguage: "en"
}
