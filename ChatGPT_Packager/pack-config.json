{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "projectName": "PVA_VPU50_SCADA",
  "version": "1.0.0",
  "description": "Packaging configuration for PVA VPU-50 SCADA source tree and git-style delta tracking.",
  "includeExtensions": [
    ".qml",
    ".ui.qml",
    ".qmlproject",
    ".qtds",
    ".qmltypes",
    ".qrc",
    ".conf",
    ".py",
    ".pyi",
    ".cpp",
    ".c",
    ".h",
    ".hpp",
    ".cxx",
    ".cmake",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".xml",
    ".md",
    ".txt",
    ".rst",
    ".bat",
    ".cmd",
    ".ps1",
    ".sh",
    ".svg",
    ".png",
    ".jpg",
    ".jpeg",
    ".ico",
    ".ttf",
    ".woff",
    ".woff2",
    ".html",
    ".css",
    ".js",
    ".st",
    ".csv"
  ],
  "includeRootFiles": [
    "CMakeLists.txt",
    "CMakeLists.txt.shared",
    "qds.cmake",
    "qtquickcontrols2.conf",
    "PVA_VPU50_SCADA.qrc",
    "PVA_VPU50_SCADA.qmlproject",
    "PVA_VPU50_SCADA.qmlproject.qtds",
    "main.py",
    "README.md",
    "scada_deploy_simulator.py",
    "vercel.json",
    ".gitignore"
  ],
  "includeDirectories": [
    "PVA_VPU50_SCADA",
    "PVA_VPU50_SCADAContent",
    "scada",
    "tests",
    "docs",
    "scripts",
    ".agents",
    "Dependencies",
    "App",
    "cmake",
    "dist",
    "assets"
  ],
  "excludeDirectories": [
    ".git",
    "ChatGPT_Packager/Output",
    "ChatGPT_Packager/State",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".venv",
    "venv",
    "env",
    "build",
    "build-*",
    "build_wasm",
    "cmake-build-*",
    "node_modules",
    "scratch",
    ".system_generated",
    ".vscode",
    ".qtcreator",
    "CMakeFiles",
    "Testing"
