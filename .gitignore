.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.user
*.useros_guid
*.sln.docstates

# Compiled binaries and libraries
*.obj
*.o
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# OS Generated Files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Temporary & backup files
*.tmp
*.bak
*.orig
*~

# Python Virtual Environments
.venv/
venv/
scratch/
scratch/*
__pycache__/
*.pyc
*.db
scada/data/

